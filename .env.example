# Bearer token with orchestration:operate scope. Issue one against the running
# T3 Code install (match its version, e.g. `npx t3@0.0.43-nightly.20260918.1895`):
#   npx t3 auth session issue --token-only --ttl 365d --label "github review orchestrator"
T3_TOKEN=

# Shared secret configured on the GitHub webhook. Strongly recommended.
GITHUB_WEBHOOK_SECRET=

# Optional. Slack trigger over Socket Mode: both are required to enable it.
# App-level token (xapp-, Basic Information -> App-Level Tokens, scope
# connections:write) and bot token (xoxb-, OAuth & Permissions).
# SLACK_APP_TOKEN=
# SLACK_BOT_TOKEN=

# Optional. Personal API key (Linear -> Settings -> Security & access -> API keys)
# so the inbox polls Linear issues assigned to you or mentioning you. Without it
# the inbox polls GitHub only, through the gh CLI.
# LINEAR_API_KEY=

# Optional. Defaults to the origin in ~/.t3/userdata/server-runtime.json.
# T3_ORIGIN=http://127.0.0.1:3773

# Optional.
# PORT=8787
# MCP server for agents, loopback only; on when Slack is configured.
# MCP_PORT=8788
# DATA_PATH=data/orchestrator.sqlite
